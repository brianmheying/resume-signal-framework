# Copy to .env and `source .env` before running, or export these directly.
# The server reads them from the environment.

# --- AI analysis (required for real analyses) ---
# Without a key the app runs in MOCK mode (returns a sample report, no AI call).
export ANTHROPIC_API_KEY=""

# Model id. Default is claude-opus-4-8 (highest quality). For cheaper/faster
# runs use claude-sonnet-4-6.
export RSF_MODEL="claude-opus-4-8"

# auto | live | mock   (auto = live if a key is present, else mock)
export RSF_MODE="auto"

# --- Beta access gate (optional but recommended before sharing) ---
# If set, the app requires this shared password to use.
export RSF_PASSWORD=""

# --- Usage ledger + public-usage rate limiter (same Apps Script webhook) ---
# See LEDGER_SETUP.md for the one-time Apps Script deploy. These two vars now
# power BOTH the usage ledger AND the durable rate-limit counter below — set
# them once and both features use them.
export RSF_LEDGER_URL=""
export RSF_LEDGER_TOKEN=""

# --- Public-usage gate (protects the Anthropic API from casual abuse) ---
# Standard allowance: 15 successful analyses per IP per rolling 24h.
# Durable (survives restarts) when RSF_LEDGER_URL/TOKEN above are set — the
# rate limiter then persists its count via the same Apps Script webhook the
# ledger uses. If those are unset, falls back to an in-memory counter that
# does NOT survive a restart/idle spin-down — fine for local dev, not for
# production.
export RSF_DAILY_LIMIT="15"        # optional — default 15
export RSF_WARN_AT="10"            # optional — default 10

# Owner-issued extended-access codes, comma-separated. Give one to someone
# who contacts you for more access; remove it (and let Render restart) to
# revoke. Leave unset to disable overrides entirely.
export RSF_ACCESS_CODES=""

# Keyed hash pepper for IPs before they're counted — never store/log a raw
# IP. Only matters once a durable (non-in-memory) store is wired in.
export RSF_IP_HASH_SECRET=""

# Shown as a "Contact [owner]" mailto action on the daily-limit screen.
# If unset, that action is simply hidden rather than shown broken.
export RSF_CONTACT_EMAIL=""

# --- Server ---
# Bind address. Default localhost. Set to 0.0.0.0 to expose (only with RSF_PASSWORD).
export RSF_HOST="127.0.0.1"
export PORT="8000"

# Note: there is no server-side persistence. The candidate profile lives only in
# the user's browser (localStorage). There are no history/DB settings anymore.
